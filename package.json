{
  "name": "supportai-keystone",
  "productName": "Keystone",
  "version": "0.1.0",
  "description": "Purpose-built project workspace for the McKesson Support AI initiative",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "John Crouch",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run build:main && vite build",
    "build:main": "node scripts/build-main.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --win",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.mckesson.supportai.keystone",
    "productName": "Keystone",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
